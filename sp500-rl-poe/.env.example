# Paths (relative to the sp500-rl-poe/ root, or absolute)
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
RESULTS_DIR=results

# Optional: directory that contains the `finrl` package if it is not installed
# via pip. Inside this FinRL fork the parent checkout is used automatically.
# FINRL_ROOT=/path/to/FinRL

# Generate a fake canonical CSV when the --input file is missing.
USE_SYNTHETIC=0

# WRDS credentials are NOT used in this repo. Copy the AB_finRL extract here:
#   data/raw/wrds_tickers.csv
#   data/raw/wrds_processed.csv
# Optional: 10-name sandbox CSV (already in configs/ab_finrl_tickers.csv)
#   data/raw/ab_finrl_tickers.csv
# WRDS_USERNAME=
